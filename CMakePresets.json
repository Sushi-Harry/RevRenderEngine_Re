{
  "version": 3,
  "configurePresets": [
    {
      "name": "base-clang",
      "hidden": true,
      "description": "Base configuration using Clang compiler",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "/usr/sbin/clang",
        "CMAKE_CXX_COMPILER": "/usr/sbin/clang++"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug",
      "description": "Debug build with symbols and no optimizations",
      "inherits": "base-clang",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "description": "Release build with maximum optimizations (-O3)",
      "inherits": "base-clang",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ]
}
